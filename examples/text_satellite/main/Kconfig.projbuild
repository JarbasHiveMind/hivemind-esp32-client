menu "HiveMind Text Satellite"

    config EXAMPLE_HIVEMIND_HOST
        string "HiveMind hub hostname or IP"
        default "192.168.1.100"
        help
            Hostname or IP address of the hivemind-core hub on the network.

    config EXAMPLE_HIVEMIND_KEY
        string "HiveMind access key"
        default ""
        help
            Access key issued by `hivemind-core add-client`.

    config EXAMPLE_HIVEMIND_PASSWORD
        string "HiveMind password"
        default ""
        help
            Password issued by `hivemind-core add-client`, used for PBKDF2 key derivation.

endmenu
